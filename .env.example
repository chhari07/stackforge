# Copy this file to .env.local and fill in what you use. Everything is optional:
# Stack works without any of it. Never put real keys in this file (it's in git).
# After changing .env.local: restart `npm run dev`, and run ./build-apk.sh again for the app.

# ---- Accounts and sync (Supabase) ----
# See supabase/README.md.
# Supabase dashboard → Project settings → API: the project URL and the
# publishable key (sb_publishable_...). Both are meant to be public (they ship
# inside the app). An older project's "anon" key works too, here or as
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud → Credentials → the "Web application" OAuth client ID: Android's
# account picker. The same ID goes into Supabase → Authentication → Providers → Google.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Stack AI ----
# Stack AI runs in the "ai" Supabase function (supabase/functions/ai). Its
# address: https://<project>.supabase.co/functions/v1/ai. Leave empty to hide AI.
NEXT_PUBLIC_AI_URL=
# Name shown in the app's "ask first" sheet, e.g. "Sarvam AI and Google Gemini".
NEXT_PUBLIC_AI_ENGINE=

# The AI keys and settings are NOT read from this file: they are the function's
# secrets, set in Supabase (dashboard → Edge Functions → Secrets, or
# `npx supabase secrets set NAME=value`). Never put a key in a NEXT_PUBLIC_ variable.
# Set any of these keys; each feature tries the engines that have one, in order,
# and moves on when one fails (out of credit, busy, down):
#   text features (summary, tidy, ask, explain): sarvam, gemini, groq, openai, anthropic
#   PDF chat (needs an engine that reads PDFs): gemini, anthropic, openai
#   SARVAM_API_KEY    dashboard.sarvam.ai → API keys (₹100 free credit on sign-up, never expires)
#   GEMINI_API_KEY    aistudio.google.com/apikey (free tier, Flash models, no card)
#   GROQ_API_KEY      console.groq.com/keys (free tier, about 1,000 requests a day per model)
#   OPENAI_API_KEY    platform.openai.com → API keys (paid)
#   ANTHROPIC_API_KEY platform.claude.com (paid)
#   AI_ENGINES        change the order or pick engines, e.g. "gemini,sarvam".
#                     Per feature: AI_ENGINES_SUMMARY, _TIDY, _ASK, _PDF, _EXPLAIN.
#   Models (each also per feature, e.g. SARVAM_MODEL_SUMMARY):
#   SARVAM_MODEL      default sarvam-105b
#   GEMINI_MODEL      default gemini-3.1-flash-lite
#   GROQ_MODEL        default openai/gpt-oss-120b
#   OPENAI_MODEL      default gpt-5.4-mini
#   AI_MODEL          Claude, default claude-sonnet-5-5 (claude-haiku-4-5 is cheaper)
#   AI_DAILY_LIMIT    requests per person per day (default 50; 20 is a safe start for a launch)
#   AI_PROVIDER       older setting: one engine to try first
#   STACK_SUPABASE_URL, STACK_SUPABASE_KEY   only when the function is hosted in another
#                     Supabase project: Stack's own project URL and publishable key

# ---- Public pages ----
# Shown on /privacy and /delete-account (Google Play links to both).
NEXT_PUBLIC_SUPPORT_EMAIL=
